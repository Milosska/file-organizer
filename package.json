{
  "name": "file-organizer",
  "version": "1.0.0",
  "description": "A Node.js CLI tool for analyzing directory contents, detecting duplicate files, organizing files into categories, and cleaning up outdated data.",
  "type": "module",
  "main": "file-organizer.js",
  "scripts": {
    "start": "node file-organizer.js start",
    "scan": "node file-organizer.js scan",
    "duplicates": "node file-organizer.js duplicates",
    "organize": "node file-organizer.js organize",
    "cleanup": "node file-organizer.js cleanup",
    "help": "node file-organizer.js --help"
  },
  "keywords": [
    "cli",
    "file organizer",
    "duplicate files",
    "directory analysis",
    "file categorization"
  ],
  "author": "Milosska",
  "license": "ISC",
  "dependencies": {
    "@inquirer/prompts": "^8.7.5",
    "yargs": "^18.2.0"
  }
}
